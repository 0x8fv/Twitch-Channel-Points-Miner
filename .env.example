## Copy this file to .env for Docker Compose. Compose forwards only the variables
## in docker-compose.yml's "environment:" block; uncomment "env_file: .env" there
## to pass the rest (the "environment:" block has prio over the `.env`).

# Twitch login used for mining and for the cookie filename.
# if empty, cookies won't be saved and you have to re-sign in on each launch
TCPM_USERNAME=

# rebuild the image instead of using the in-container updater
TCPM_AUTO_UPDATE=false

# list of channel logins to mine; empty mines all followed channels
TCPM_STREAMERS=

# list of channel logins to skip (case INsensitive)
TCPM_STREAMERS_EXCLUDE=

# enable Twitch prediction betting
# trailing _ because the config key is "betting(make_predictions)"
TCPM_BETTING_MAKE_PREDICTIONS_=true

# auto-claim drops at boot, continue claiming while running, auto-follow raid targets
TCPM_CLAIM_DROPS_STARTUP=true
TCPM_CLAIM_DROPS=true
TCPM_FOLLOW_RAID=true

# global default for listening to and claiming Twitch Moments via PubSub
TCPM_CLAIM_MOMENTS=true

# write console output to log/<username>.log in addition to stdout
TCPM_SAVE_LOGS=false

# replace streamer names and point balances in logs with anonymized values;
# when enabled, save_logs writes to log/miner.log
TCPM_PRIVACY_ANONYMIZE_LOGS=false

# optional; device login is used, so you can leave this as-is
TCPM_PASSWORD=

# optional IANA timezone name (e.g. Europe/Berlin) to override auto-detection
TCPM_TIMEZONE=

# enable debug logs (high-level request summaries, PubSub message metadata)
TCPM_DEBUG=false

# enable deep debug logs (full request/response bodies and PubSub payloads);
# only emitted when TCPM_PRIVACY_ANONYMIZE_LOGS is false
TCPM_DEBUG_DEEP=false

# high-level logging preferences
TCPM_SMART_LOGGING=true
TCPM_EMOJIS=true
TCPM_SHOW_SECONDS=false
TCPM_SHOW_USERNAME_IN_CONSOLE=false
TCPM_SHOW_CLAIMED_BONUS_MSG=true

# Discord webhook notifications (JSON object for the whole block)
TCPM_DISCORD=

# disable TLS certificate/hostname verification for PubSub WebSockets only
TCPM_DISABLE_SSL_CERT_VERIFICATION=false

# log compact DROP_PROGRESS status lines during 30-minute drop inventory checks
TCPM_SHOW_DROPS_PROGRESS=false

# reuse watch-streak state across restarts for still-live streams
TCPM_WATCH_STREAK_WARM_START_CACHE=true

# also trigger CHAT_MENTION on plain username mentions (without @)
TCPM_DISABLE_AT_IN_NICKNAME=false

# per-streamer overrides (JSON object)
TCPM_STREAMER_OVERRIDES=

# log the game a streamer is playing on join and on watch-point gains
TCPM_SHOW_GAME=false

# ordered game names to prefer and names to skip entirely (comma-separated)
TCPM_GAME_PRIORITY=
TCPM_GAME_EXCLUDE=

# advanced prediction tuning
TCPM_BET_STRATEGY=SMART
TCPM_BET_PERCENTAGE=5
TCPM_BET_PERCENTAGE_GAP=20
TCPM_BET_MAX_POINTS=50000
TCPM_BET_MINIMUM_POINTS=0
TCPM_BET_STEALTH_MODE=false
TCPM_BET_DELAY_MODE=FROM_END
TCPM_BET_DELAY=6
TCPM_BET_FILTER_CONDITION=

# path overrides
TCPM_CONFIG=
TCPM_DATA_DIR=/app/data